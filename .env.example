# Supabase Configuration
# Project URL: Found in Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project.supabase.co

# Service Role Secret: Found in Supabase Dashboard -> Project Settings -> API -> Project API Keys -> service_role secret
# Using the service_role key bypasses Row-Level Security (RLS) policies completely.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
